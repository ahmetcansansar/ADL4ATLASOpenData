# Z Boson Analysis

#info analysis
#  title Review of the 13 TeV ATLAS Open Data Release
#  experiment ATLAS
#  id PUB-OTRC-2020-01
#  lumi 10 fb-1
#  sqrts 13
#  publication https://cds.cern.ch/record/2707171

object goodEles : ELE
  select Pt(ELE) > 25
  select absEta(ELE) < 2.47
  reject absEta(ELE) [] 1.37 1.52
  select lep_isTightID(ELE) == 1
  select lep_ptcone30(ELE)/lep_pt(ELE) < 0.15
  select lep_etcone20(ELE)/lep_pt(ELE) < 0.15
  select abs(lep_z0(ELE)*sin(Theta(ELE))) < 0.5
  select abs(lep_trackd0pvunbiased(ELE))/lep_tracksigd0pvunbiased(ELE) < 5

object goodMuos : MUO
  select Pt(MUO) > 25
  select absEta(MUO) < 2.5
  select lep_isTightID(MUO) == 1
  select lep_ptcone30(MUO)/lep_pt(MUO) < 0.15
  select lep_etcone20(MUO)/lep_pt(MUO) < 0.15
  select abs(lep_trackd0pvunbiased(MUO))/lep_tracksigd0pvunbiased(MUO) < 3
  select abs(lep_z0(MUO)*sin(Theta(MUO))) < 0.5

object goodLepts : Union(goodEles,goodMuos)

#### weights ####
##### weights #####
define Sfactor : scaleFactor_ELE*scaleFactor_MUON*scaleFactor_LepTRIGGER*scaleFactor_PILEUP*scaleFactor_BTAG
define Lumi : 10064 # 10 fb-1

# Single-top samples (DSID 410011-410026) carry mis-scaled mcWeight and SumWeights
# branches in the 2020 ntuples; only sign(mcWeight) is used and the sum of weights
# is the number of generated events.
define isSingleTop = HSTEP(channelNumber > 410010) * HSTEP(channelNumber < 410027)
define mcW = isSingleTop * (HSTEP(mcWeight) - HSTEP(0 - mcWeight)) + (1 - isSingleTop) * mcWeight
define totweight : XSection*mcW*Sfactor*Lumi

define totalWeight : HSTEP(channelNumber < 310000) * 1 + HSTEP(channelNumber > 310000) * totweight
# For data, total weight = 1

define Lepton1  : goodLepts[0]
define Lepton2  : goodLepts[1]
define Lepton12 : Lepton1 Lepton2
define mLL : m(Lepton12)
define zMassWindow : abs(mLL - 91.18)

region preselections
  select ALL
  weight evtweight totalWeight
  select Size(goodEles) >= 0
  select Size(goodMuos) >= 0
  select Size(goodLepts) >= 0
  sort Pt(goodLepts) descend

region ZBosonAnalysis_ll
  preselections
  select trigE == 1 OR trigM == 1
  select Size(goodLepts) == 2
  select Size(JET) == 0
  select q(Lepton1)*q(Lepton2) < 0
  select Abs(pdgID(Lepton1)) == Abs(pdgID(Lepton2))
  select zMassWindow < 25
  histo hPtleadlep,"Leading Lepton Transverse Momentum;p_{T}^{leadlep} [GeV];Events / bin",20,0,200,Pt(Lepton1)
  histo hEtaleadlep,"Leading Lepton Pseudorapidity; #eta^{leadlep}; Events / bin",30,-3,3,Eta(Lepton1)
  histo hPhileadlep,"Leading Lepton Azimuthal Angle ; #phi^{leadlep}; Events / bin",32,-3.2,3.2,Phi(Lepton1)
  histo hEleadlep,"Leading Lepton Energy; E^{leadlep} [GeV]; Events / bin",30,0,300,E(Lepton1)
  histo hQleadlep,"Leading Lepton Charge; Q^{leadlep}; Events / bin",7,-1.75,1.75,q(Lepton1)
  histo hPDGID,"Leading Lepton Absolute PDG ID; |PDG ID|^{leadlep}; Events / bin",15,5.5,20.5,abs(PDGID(Lepton1))
  histo hZllMass1,"Mass of Dilepton System; m_{ll} [GeV];Events / bin",30,68,114,mLL

region ZBosonAnalysis_ee
  ZBosonAnalysis_ll
  select Abs(pdgID(Lepton1)) == 11
  histo hZeeMass1,"Mass of Dilepton(ee) System; m_{ee} [GeV];Events / bin",30,68,114,mLL
  histo hPtleadlep1,"Leading Lepton Transverse Momentum;p_{T}^{leadlep} [GeV];Events / bin",20,0,200,Pt(Lepton1)
  histo hEtaleadlep1,"Leading Lepton Pseudorapidity; #eta^{leadlep}; Events / bin",30,-3,3,Eta(Lepton1)
  histo hPhileadlep1,"Leading Lepton Azimuthal Angle ; #phi^{leadlep}; Events / bin",32,-3.2,3.2,Phi(Lepton1)
  histo hEleadlep1,"Leading Lepton Energy; E^{leadlep} [GeV]; Events / bin",30,0,300,E(Lepton1)
  histo hQleadlep1,"Leading Lepton Charge; Q^{leadlep}; Events / bin",7,-1.75,1.75,q(Lepton1)
  histo hPDGID1,"Leading Lepton Absolute PDG ID; |PDG ID|^{leadlep}; Events / bin",15,5.5,20.5,abs(PDGID(Lepton1))

region ZBosonAnalysis_mm
  ZBosonAnalysis_ll
  select Abs(pdgID(Lepton1)) == 13
  histo hZmmMass1,"Mass of Dilepton(#mu#mu) System; m_{#mu#mu} [GeV];Events / bin",30,68,114,mLL
  histo hPtleadlep1,"Leading Lepton Transverse Momentum;p_{T}^{leadlep} [GeV];Events / bin",20,0,200,Pt(Lepton1)
  histo hEtaleadlep1,"Leading Lepton Pseudorapidity; #eta^{leadlep}; Events / bin",30,-3,3,Eta(Lepton1)
  histo hPhileadlep1,"Leading Lepton Azimuthal Angle ; #phi^{leadlep}; Events / bin",32,-3.2,3.2,Phi(Lepton1)
  histo hEleadlep1,"Leading Lepton Energy; E^{leadlep} [GeV]; Events / bin",30,0,300,E(Lepton1)
  histo hQleadlep1,"Leading Lepton Charge; Q^{leadlep}; Events / bin",7,-1.75,1.75,q(Lepton1)
  histo hPDGID1,"Leading Lepton Absolute PDG ID; |PDG ID|^{leadlep}; Events / bin",15,5.5,20.5,abs(PDGID(Lepton1))
