# ZPrimeBoostedAnalysis -- ATLAS Open Data 13 TeV (2020 release) benchmark, ADL for CutLang
#
# One ADL for all samples. Event weights follow the ATLAS Open Data C++ framework:
#   MC:   XSection * Lumi * scale factors * mcWeight, per event (below), then
#         x 1/(sum of weights) per sample in post-processing
#         (scripts/normalize_merge.py with config/samples/ZPrimeBoostedAnalysis.yaml)
#   data: 1
# Derived from the per-sample ADLs of the paper's original workflow by
# tools/legacy/make_unified_adls.py.

### BSM Z' Analysis ###
object goodEle : ELE
  select Pt(ELE) > 30
  select absEta(ELE) < 2.47
  reject absEta(ELE) [] 1.37 1.52
  select lep_ptcone30(ELE)/lep_pt(ELE) < 0.15
  select lep_etcone20(ELE)/lep_pt(ELE) < 0.15
  select abs(lep_z0(ELE)*sin(theta(ELE))) < 0.5
  select abs(lep_trackd0pvunbiased(ELE))/lep_tracksigd0pvunbiased(ELE) < 5
  select lep_isTightID(ELE) == 1

object goodMuo : MUO
  select Pt(MUO) > 30
  select absEta(MUO) < 2.5
  select lep_ptcone30(MUO)/lep_pt(MUO) < 0.15
  select lep_etcone20(MUO)/lep_pt(MUO) < 0.15
  select abs(lep_z0(MUO)*sin(theta(MUO))) < 0.5
  select abs(lep_trackd0pvunbiased(MUO))/lep_tracksigd0pvunbiased(MUO) < 3
  select lep_isTightID(MUO) == 1

object goodLep : Union(goodEle,goodMuo)

object goodJet : JET
  select Pt(JET) > 30
  select absEta(JET) < 2.5
  reject Pt(JET) < 60 && absEta(JET) < 2.4 && jet_jvt(JET) < 0.59

object goodDRJet : goodJet
  select ALL
  select dR(goodJet,goodLep[0]) < 2.0

object goodBJet : goodJet
  select jet_MV2c10(goodJet) > 0.8244273

object goodFJet : FJET
  select absEta(FJET) < 2.0
  select m(FJET) > 50
  select Pt(FJET) > 250

#object topLRJet : goodFJet
#  select absEta(goodFJet) < 2.0
#  select m(goodFJet) > 100
#  select Pt(goodFJet) > 300 && Pt(goodFJet) < 1500
#  select Flavor(goodFJet) < 0.75
#  select dR(goodFJet, goodDRJet[0]) > 1.5
#  select dPhi(goodFJet, goodLep[0]) > 1.0
#  print dR(goodBJet, goodFJet)
#  select anyof(dR(goodBJet, goodFJet)) < 1.0 OR anyof(dR(goodBJet, goodDRJet)) < 0.01

object bsmallR : goodBJet
   #print dR(goodBJet, goodDRJet[0])
   select dR(goodBJet, goodDRJet[0]) < 0.01
   #print Pt(goodBJet) - Pt(goodDRJet[0])
   #select Pt(goodBJet) - Pt(goodDRJet[0]) < 100

object topLRJet : goodFJet
  select absEta(goodFJet) < 2.0
  select m(goodFJet) > 100
  select Pt(goodFJet) > 300 && Pt(goodFJet) < 1500
  select Flavor(goodFJet) < 0.75
  #print  dR(goodFJet, goodDRJet[0])
  select dR(goodFJet, goodDRJet[0]) > 1.5
  select dPhi(goodFJet, goodLep[0]) > 1.0

  #print dR(goodFJet[0], goodBJet[0]) dR(goodFJet[0], goodBJet[1]) dR(goodFJet[0], goodBJet[2])
  #print dR(goodFJet, goodBJet[0]) dR(goodFJet, goodBJet[1]) dR(goodFJet, goodBJet[2])
  select dR(goodFJet, goodBJet[0]) < 1.0 OR (Size(goodBJet) > 1 AND dR(goodFJet, goodBJet[1]) < 1.0) OR (Size(goodBJet) > 2 AND dR(goodFJet, goodBJet[2]) < 1.0) OR (Size(goodBJet) > 3 AND dR(goodFJet, goodBJet[3]) < 1.0) OR (Size(goodBJet) > 4 AND dR(goodFJet, goodBJet[4]) < 1.0) OR (Size(goodBJet) > 5 AND dR(goodFJet, goodBJet[5]) < 1.0) OR Size(bsmallR) >= 1
  #select dR(goodFJet[0], goodBJet[0]) < 1.0 OR dR(goodFJet[0], goodBJet[1]) < 1.0 OR dR(goodFJet[1], goodBJet[0]) <1.0 OR dR(goodFJet[1], goodBJet[1]) < 1.0 OR Size(bsmallR) >= 1
  #select dR(goodFJet, goodBJet[0]) < 1.0 OR dR(goodFJet, goodBJet[1]) < 1.0 OR dR(goodFJet,goodBJet[2]) < 1.0 OR dR(goodFJet,goodBJet[3]) < 1.0 OR dR(goodFJet,goodBJet[4]) < 1.0 OR dR(goodFJet,goodBJet[5]) < 1.0 OR Size(bsmallR) >= 1
  #select dR(goodFJet[0], goodBJet[0]) < 1.0 OR dR(goodFJet[0], goodBJet[1]) < 1.0 OR dR(goodFJet[0], goodBJet[2]) < 1.0 OR dR(goodFJet[1], goodBJet[0]) < 1.0 OR dR(goodFJet[1], goodBJet[1]) < 1.0 OR dR(goodFJet[1], goodBJet[2]) < 1.0 OR Size(bsmallR) >= 1

  #select anyof(dR(goodFJet, goodBJet)) < 1.0 OR Size(bsmallR) >= 1
  #select (dR(goodBJet[0], goodFJet) < 1.0 OR ((Size(goodBJet) > 1) AND dR(goodBJet[1], goodFJet) < 1.0) OR ((Size(goodBJet) > 2) AND dR(goodBJet[2], goodFJet) < 1.0)) OR Size(bsmallR) >= 1
  #select (dR(goodFJet, goodBJet[0]) < 1.0 OR ((Size(goodBJet) > 1) AND dR(goodFJet, goodBJet[1]) < 1.0) OR ((Size(goodBJet) > 2) AND dR(goodFJet, goodBJet[2]) < 1.0)) OR Size(bsmallR) >= 1


define MTW : sqrt(2*Pt(goodLep[0])*MET*(1 - cos(dPhi(goodLep[0],METLV[0]))))


define toplep : goodDRJet[0] goodLep[0]
define tophad : topLRJet[0]
define ttbar : toplep tophad

##### weights #####
define Sfactor : scaleFactor_ELE*scaleFactor_MUON*scaleFactor_LepTRIGGER*scaleFactor_PILEUP*scaleFactor_BTAG
define Lumi : 10064 # 10 fb-1

# Single-top samples (DSID 410011-410026) carry mis-scaled mcWeight and SumWeights
# branches in the 2020 ntuples; as in the original workflow only sign(mcWeight)
# is used and the sum of weights is the number of generated events.
define isSingleTop = HSTEP(channelNumber > 410010) * HSTEP(channelNumber < 410027)
define mcW = isSingleTop * (HSTEP(mcWeight) - HSTEP(0 - mcWeight)) + (1 - isSingleTop) * mcWeight
define totweight : XSection*mcW*Sfactor*Lumi

define isData : HSTEP(channelNumber < 310000) * (1 - DELTA(channelNumber - 301325))
define totweightAuto : isData * 1 + (1 - isData) * totweight
# For data, total weight = 1
#
#define dPhiTopLRLep : min(dPhi(topLRJet[:1],goodLep[0]))
define dPhiTopLRLep : HSTEP(dPhi(topLRJet[0],goodLep[0]) > 1.0 OR dPhi(topLRJet[1],goodLep[0]) > 1.0)


#define dRgoodT : min(dR(topLRJet[:1], goodDRJet[0]))

define dRTopLRsmallR : HSTEP(dR(topLRJet[0], goodDRJet[0]) > 1.5 OR dR(topLRJet[1], goodDRJet[0]) > 1.5)

define dR_bjet_TopLR : dR(goodBJet[0],topLRJet[0])
define dR_bjet_smallRjet : dR(goodBJet[0],goodDRJet[0])

define dR_bjet_TopLR1 : dR(goodBJet[1],topLRJet[0])
define dR_bjet_TopLR2 : dR(goodBJet[2],topLRJet[0])

define dR_bjet_smallRjet1 : dR(goodBJet[1],goodDRJet[0])
define dR_bjet_smallRjet2 : dR(goodBJet[2],goodDRJet[0])

#define btag_is_within_TopLR : HSTEP(dR_bjet_TopLR < 1.0) OR dR_bjet_TopLR1 < 1.0)
#define btag_is_smallRjet : HSTEP(dR_bjet_smallRjet < 0.01) OR dR_bjet_smallRjet1 < 0.01)

#define btag_is_within_TopLR : HSTEP(dR(goodBJet[0], topLRJet[0]) < 1.0)

define btag_is_within_TopLR : HSTEP((dR_bjet_TopLR < 1.0) OR ((Size(goodBJet) > 1) AND (dR_bjet_TopLR1 < 1.0)) OR ((Size(goodBJet) > 2) AND (dR_bjet_TopLR2 < 1.0)))
define btag_is_smallRjet : HSTEP((dR_bjet_smallRjet < 0.01) OR ((Size(goodBJet) > 1) AND (dR_bjet_smallRjet1 < 0.01)) OR ((Size(goodBJet) > 2) AND (dR_bjet_smallRjet2 < 0.01)))

region Zprime
  select ALL
  weight eventweight totweightAuto
  select Size(FJET) >= 1
  select MET > 20
  select trigE == 1 || trigM == 1
  select Size(goodEle) >= 0
  select Size(goodMuo) >= 0
  select Size(goodLep) == 1
  #print "Event" eventno "goodLep pt: " Pt(goodLep)
  Sort Pt(goodLep) descend
  select (MET + MTW) > 60
  #print "Event" eventno "MET+MTW: " MET+MTW
  select Size(goodBJet) >= 1
  #print "Event" eventno "Size(goodBJet)" Size(goodBJet)
  select Size(goodDRJet) >= 1
  #print "Event" eventno "Size(goodDRJet)" Size(goodDRJet)


  select Size(goodFJet) >= 0
  histo hNlargeRjet, "Number of top-tagged Large-R Jets;N^{Large-R jets};Events", 4, -0.5, 3.5,Size(goodFJet)
  histo hleadLRpt, "Large-R Jet Transverse Momentum;p_{T}^{Large-R jet} [GeV];Events / bin", 30, 250, 700,Pt(goodFJet)
  histo hleadLReta, "Large-R Jet Pseudorapidity; #eta^{Large-R jet}; Events / bin", 20, -3, 3,Eta(goodFJet)
  histo hleadLRphi, "Large-R Jet phi; #phi^{Large-R jet}; Events / bin", 12, -3.2, 3.2,Phi(goodFJet)
  histo hleadLRm,   "Large-R Jet mass; m^{Large-R jet} [GeV]; Events / bin", 30, 50, 250,m(goodFJet)
  #print "Event" eventno "goodFJet pT: " Pt(goodFJet)
  #select Size(preTopLRJet) >= 1
  #print "Event" eventno "dR dR_bjet_TopLR" dR(goodBJet, preTopLRJet[0])
  #print "Event" eventno "btag_is_within_TopLR" btag_is_within_TopLR
  #print "Event" eventno "dR dR_bjet_smallRjet" dR(goodBJet, goodDRJet[0])
  #print "Event" eventno "btag_is_smallRjet" btag_is_smallRjet
  #print "Event" eventno "dR dR_bjet_smallRjet" dR(goodBJet, goodDRJet[0])
  #print "Event" eventno "preTopLRJet mass" m(preTopLRJet)
  #select Size(topLRJet) >= 0
  #select Size(topLRJet_bSmall) > 0
  #print "Event" eventno "dR BJET smallR" dR(goodBJet[0], goodDRJet[0]) "size topLRJet_bSmall" size(topLRJet_bSmall)
  #print eventno btag_is_within_TopLR
  #print eventno dRgoodT
  #print "Event" eventno "dPhi(goodLep[0], TopLRJet)" dPhi(goodLep[0], topLRJet[0])
  #print "Event" eventno "Pt topLRJet" Pt(topLRJet[0])
  #print "Event" eventno "dPhi" dPhiTopLRLep
  #print "Event" eventno "dR" dRTopLRsmallR
  #select dRgoodT > 1.5 && dPhiTopLRLep > 1
  #select dRTopLRsmallR == 1 && dPhiTopLRLep == 1
  #print "Event" eventno "dR(goodDRJet, goodBJet[0])" dR(goodDRJet, goodBJet[0]) Size(goodDRinBJet)
  #select btag_is_within_TopLR == 1 OR btag_is_smallRjet == 1
  #select btag_is_within_TopLR == 1 OR Size(bsmallR) >= 1
  select Size(topLRJet) == 1
 #print "Event" eventno "Size(goodBJet)" Size(goodBJet) "Size(bsmallR)"  Size(bsmallR)
 #print "Event" eventno "Size(topLRJet)" Size(topLRJet)
 # print "Event" eventno "dRs" dR(goodDRJet[0], topLRJet)
 # print "Event" eventno "dPhis" dPhi(goodLep[0], topLRJet)
 # print "Event" eventno "dR dR_bjet_smallRjet" dR(goodBJet, goodDRJet[0])
 # print "Event" eventno "dR dR_bjet_TopLR" dR(goodBJet, topLRJet[0])
 # print "Event" eventno "btag_is_within_TopLR" btag_is_within_TopLR
 # print "Event" eventno "btag_is_smallRjet" btag_is_smallRjet
  ######
  #print "Event" eventno "Size(topLRJet)" Size(topLRJet)
  #print "Event" eventno "dRs" dR(goodDRJet[0], topLRJet)
  #print "Event" eventno "dRs" dR(goodDRJet[0], topLRJet[0]) dR(goodDRJet[0], topLRJet[1])
  #print "Event" eventno "dPhis" dPhi(goodLep[0], topLRJet[0]) dPhi(goodLep[0], topLRJet[1])
  #print "Event" eventno "dR dR_bjet_smallRjet" dR(goodBJet, goodDRJet[0])
  #print "Event" eventno "dR dR_bjet_TopLR" dR(goodBJet, topLRJet[0])
  #print "Event" eventno "Size(goodBJet)" Size(goodBJet)
  #print "Event" eventno "dR_bjet_TopLR0" dR(goodBJet[0], topLRJet[0])
  #print "Event" eventno "dR_bjet_TopLR1" dR(goodBJet[0], topLRJet[1])
  #print "Event" eventno "Size toplr" Size(topLRJet)
  #print "Event" eventno "btag_is_within_TopLR" btag_is_within_TopLR
  #print "Event" eventno "dR dR_bjet_smallRjet" dR(goodBJet, goodDRJet[0])
  #print "Event" eventno "btag_is_smallRjet" btag_is_smallRjet
  histo hPttopLRjet, "Top-tagged Large-R Jet Transverse Momentum;p_{T}^{Top-tagged Large-R jet} [GeV];Events / bin", 30, 250, 700,Pt(topLRJet[0])
  histo hEtatopLRjet, "Top-tagged Large-R Jet Pseudorapidity; #eta^{Top-tagged Large-R jet}; Events / bin", 20, -3, 3,Eta(topLRJet[0])
  histo hPhitopLRjet, "Top-tagged Large-R Jet phi; #phi^{Top-tagged Large-R jet}; Events / bin", 12, -3.2, 3.2,Phi(topLRJet[0])
  histo hMasstopLRjet, "Top-tagged Large-R Jet mass; m^{Top-tagged Large-R jet} [GeV]; Events / bin", 25, 100, 250,m(topLRJet[0])
  select jet_MV2c10(goodDRJet[0]) > 0.8244273
  histo httbarm, " (Almost) ttbar mass (no neutrino); m^{Top-tagged Large-R jet, Small-R jet, Lepton} [GeV]; Events / bin", 20, 400, 1600, m(ttbar)
